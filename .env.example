# ─────────────────────────────────────────
# Denavy 설정 파일
# ─────────────────────────────────────────
# 이 파일을 .env 로 복사한 뒤 값을 채우세요:
#   copy .env.example .env
#
# 환경변수로도 설정 가능 (접두사 DENAVY_):
#   set DENAVY_API_KEY=sk-xxx
#   set DENAVY_DEFAULT_MODEL=gpt-4o

# ── LLM 설정 ──
# litellm 형식 모델명
#   OpenAI:    gpt-4o, gpt-4o-mini
#   Anthropic: claude-sonnet-4-20250514
#   Ollama:    ollama/llama3
#   Gemini:    gemini/gemini-2.0-flash
DENAVY_DEFAULT_MODEL=gpt-4o-mini

# API 키 (프로바이더에 따라 자동 매핑)
#   OpenAI → sk-xxx
#   Anthropic → sk-ant-xxx
#   Ollama → 비워두세요
DENAVY_API_KEY=

# API 베이스 URL (선택)
#   Ollama: http://localhost:11434
#   vLLM:   http://localhost:8000/v1
#   비워두면 기본 엔드포인트 사용
DENAVY_API_BASE=

# ── Deno 샌드박스 (선택) ──
DENAVY_DENO_DEPLOY_TOKEN=
DENAVY_SANDBOX_TIMEOUT=30

# ── 파이프라인 ──
DENAVY_MAX_RETRY_ON_REJECT=3

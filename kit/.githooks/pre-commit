#!/bin/sh
# =============================================================================
# Denavy Pre-commit Hook — FSM 상태 기반 spec/ 접근 통제
# =============================================================================
# 명세 문서 (spec/spec.md, spec/dna/) → SPEC_ANALYZE 에서만 수정 가능
# 테스트 파일 (spec/test/)            → SPEC_ANALYZE, IMPLEMENTING,
#                                       TEST_RUNNING, MERGED 에서 허용
#
# 초기 세팅: git config core.hooksPath .githooks
# =============================================================================

# state.md에서 현재 FSM 상태를 추출 (LLM 공백 변형에 방어적 파싱)
STATE_FILE=".denavy/state.md"

if [ ! -f "$STATE_FILE" ]; then
    echo "⚠️  Denavy: $STATE_FILE 파일을 찾을 수 없습니다. Hook을 건너뜁니다."
    exit 0
fi

# sed로 콜론 뒤 공백을 유연하게 처리, tr로 잔여 공백/개행 제거
STATE=$(grep "^state:" "$STATE_FILE" | sed 's/^state:[[:space:]]*//' | tr -d '[:space:]')

if [ -z "$STATE" ]; then
    echo "⚠️  Denavy: state.md에서 state 필드를 파싱할 수 없습니다. Hook을 건너뜁니다."
    exit 0
fi

# 변경된 파일 목록 캐싱 (git diff 호출 최소화)
STAGED_FILES=$(git diff --cached --name-only)

# ── 1. 명세 문서 보호 (spec/test/ 제외) ──
SPEC_DOC_CHANGED=$(printf "%s\n" "$STAGED_FILES" | grep "^spec/" | grep -v "^spec/test/")

if [ -n "$SPEC_DOC_CHANGED" ] && [ "$STATE" != "SPEC_ANALYZE" ]; then
    echo ""
    echo "❌ Denavy: spec/ 명세 문서 수정 차단"
    echo ""
    echo "   현재 FSM 상태: $STATE"
    echo "   허용 상태:     SPEC_ANALYZE"
    echo ""
    echo "   spec/spec.md 및 spec/dna/ 는 SPEC_ANALYZE 상태에서만 수정 가능합니다."
    echo ""
    exit 1
fi

# ── 2. 테스트 파일 보호 (허용 범위 확장) ──
SPEC_TEST_CHANGED=$(printf "%s\n" "$STAGED_FILES" | grep "^spec/test/")

if [ -n "$SPEC_TEST_CHANGED" ]; then
    case "$STATE" in
        SPEC_ANALYZE|IMPLEMENTING|TEST_RUNNING|MERGED) ;;
        *)
            echo ""
            echo "❌ Denavy: spec/test/ 수정 차단"
            echo ""
            echo "   현재 FSM 상태: $STATE"
            echo "   허용 상태:     SPEC_ANALYZE | IMPLEMENTING | TEST_RUNNING | MERGED"
            echo ""
            exit 1
            ;;
    esac
fi

exit 0

